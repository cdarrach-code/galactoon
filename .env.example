# Required for live OpenAI image edits.
# Without this key the studio runs in mock preview mode.
OPENAI_API_KEY=

# Optional. When set, admin/compare APIs require header: x-admin-token
ADMIN_API_TOKEN=

# Optional. Enables developer comparison mode without visiting /admin
DEV_COMPARISON_MODE=true

# Approval email destination for "Approve final design"
APPROVAL_EMAIL=cdarrach@gmail.com

# Optional preferred mailer for approvals (falls back to FormSubmit)
RESEND_API_KEY=
# RESEND_FROM_EMAIL=Galactic Toon Studio <onboarding@resend.dev>
